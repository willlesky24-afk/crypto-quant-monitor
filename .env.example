# ==============================================================================
# Crypto Quant Monitor — Environment Configuration Template (.env)
# ==============================================================================

# Runtime Environment (production | staging | development)
ENVIRONMENT=production
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# API Gateway & Server Configuration
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1
SERVER_RELOAD=false

# ------------------------------------------------------------------------------
# API Gateway Security & Access Control
# ------------------------------------------------------------------------------
# Secret token required in X-API-Key header (required if SECURITY_ENABLED=true)
OPERATOR_API_KEY=
OPERATOR_API_SECURITY_ENABLED=true

# Rate Limiting (per-client sliding window)
OPERATOR_API_RATE_LIMIT_ENABLED=true
OPERATOR_API_RATE_LIMIT_PER_MINUTE=60

# CORS Allowed Origins (comma-separated or * for all)
OPERATOR_API_CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# Persistent Storage Paths
# ------------------------------------------------------------------------------
DATA_DIR=/app/data
DATABASE_PATH=/app/data/market_contexts.db
PARQUET_DIR=/app/data/parquet

# ------------------------------------------------------------------------------
# Market Streaming Configuration
# ------------------------------------------------------------------------------
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
SYMBOL=BTCUSDT
TIMEFRAME=1h
STREAMING_BUFFER_SIZE=500

# ------------------------------------------------------------------------------
# Observability & Telemetry
# ------------------------------------------------------------------------------
METRICS_ENABLED=true
JSON_LOGGING_ENABLED=true

# ------------------------------------------------------------------------------
# Notification Channels (Optional integrations)
# ------------------------------------------------------------------------------
# Discord Webhook URL
DISCORD_WEBHOOK_URL=

# Telegram Bot Token and Chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic HTTP Webhook Endpoint
GENERIC_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# Real AI Provider Configuration (Phase 9/10 Copilot)
# ------------------------------------------------------------------------------
# Active AI Provider: gemini | mock | openai | ollama
AI_PROVIDER=gemini

# Google Gemini API Settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Ollama Settings (Optional / Private)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# LLM Resilience Settings
LLM_TIMEOUT_SECONDS=10.0
LLM_MAX_RETRIES=2

